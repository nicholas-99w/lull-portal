# Copy to .env (never commit .env). Every setting the compose deployment reads.

# Postgres password (used by both containers). Any characters are fine; if it
# contains a $, wrap the whole value in single quotes ('...') so Compose
# doesn't treat it as a variable.
POSTGRES_PASSWORD=change-me-postgres

# Password for lull_app, the database user the portal itself connects as (it
# can read and write data, but not change the schema; the owner above is used
# only by the migrate and backup steps). Any characters; same $ rule as above.
# Change it at any time: the next `docker compose up` applies it.
LULL_APP_DB_PASSWORD=change-me-app-db

# Shared secret Macs present once to register. At least 16 characters.
# Deploy the same value to Macs with the Jamf enrolment script (root-only file).
LULL_ENROLMENT_SECRET=change-me-enrolment-secret

# true behind the HTTPS reverse proxy (the usual production setup), so the
# portal sees each visitor's own address: without it, rate limits count every
# parent against the proxy's one address. Safe while LULL_PORTAL_BIND is
# 127.0.0.1, since only this host can then reach the port. With no proxy at all,
# set it to false. Behind a proxy, sign-in cookies are always marked Secure
# (HTTPS only); Chrome, Edge and Firefox allow that on http://localhost too,
# but Safari doesn't, so test locally in one of those or set this to false.
LULL_TRUST_FORWARDED_HEADERS=true

# The proxies whose X-Forwarded-For counts, as addresses or CIDR ranges,
# comma-separated (optional). Default: private and loopback addresses only,
# which covers a proxy on this host or the local network, while the header from
# anyone on the internet is ignored.
# LULL_TRUSTED_PROXIES=10.0.0.5

# The portal's domain name(s), semicolon-separated (optional; default * = any).
# Requests for any other Host are refused with 400.
# LULL_ALLOWED_HOSTS=portal.example.edu.au

# Sign-in, password setup and first-run attempts per client IP per minute
# (optional; default 20).
# LULL_RATE_LIMIT_PER_MINUTE=20

# Mac registrations per client IP per minute (optional; default 300). A school's
# Macs register from behind one address (NAT), so this is much higher.
# LULL_REGISTER_RATE_LIMIT_PER_MINUTE=300

# Device API requests with a token that matches no Mac, per client IP per minute,
# before that client is refused for the rest of the minute (optional; default 60).
# Real Macs almost never send one, so this only stops a flood of made-up tokens.
# LULL_DEVICE_AUTH_FAILURES_PER_MINUTE=60

# Days to keep audit log entries (optional; default 365). 0 keeps them forever.
# Like LULL_LOCAL_SIGN_IN and LULL_ENTRA_LINK_LOCAL_ACCOUNTS below, only a starting
# value: once the owner saves Settings > Sign-in in the portal, that applies instead.
# LULL_AUDIT_RETENTION_DAYS=365

# Sign in with Microsoft (Entra ID), optional: docs/entra-id.md.
# Set the tenant ID, client ID and client secret of the portal's app
# registration to turn it on. Local accounts (passwords, setup codes, CSV import)
# keep working alongside it unless LULL_LOCAL_SIGN_IN is false; the owner can
# always sign in with a password, as the emergency admin.
# LULL_ENTRA_TENANT_ID=
# LULL_ENTRA_CLIENT_ID=
# LULL_ENTRA_CLIENT_SECRET=
# The ID token claim with a parent's student usernames, comma-separated (default students).
# LULL_ENTRA_STUDENTS_CLAIM=students
# App roles that make someone an admin or a parent (defaults Admin and Parent).
# An empty parent role makes everyone else who can sign in a parent.
# LULL_ENTRA_ADMIN_ROLE=Admin
# LULL_ENTRA_PARENT_ROLE=Parent
# true: a first Microsoft sign-in takes over the local account with the same
# email (moving existing accounts to Entra). Default false: refused instead.
# LULL_ENTRA_LINK_LOCAL_ACCOUNTS=false
# false: no local sign-in (Microsoft only, apart from the owner).
# LULL_LOCAL_SIGN_IN=true

# Backups (optional; these are the defaults): a backup when the backup service
# starts, then daily at LULL_BACKUP_AT in LULL_BACKUP_TZ, into LULL_BACKUP_DIR
# on this server, each kept for LULL_BACKUP_KEEP_DAYS days.
# LULL_BACKUP_DIR=./backups
# LULL_BACKUP_AT=02:00
# LULL_BACKUP_TZ=Australia/Sydney
# LULL_BACKUP_KEEP_DAYS=14

# Host address and port. 127.0.0.1: only a reverse proxy on this
# host can reach the portal. 0.0.0.0 for a proxy on another machine, and then
# firewall the port so only the proxy can reach it.
LULL_PORTAL_BIND=127.0.0.1
LULL_PORTAL_PORT=8080

# The portal's image. Leave unset: compose.yml names the published image for the
# release this copy is checked out at, and ./update.sh moves it on. Set it only
# to run an image of your own, such as one built with --build.
# LULL_PORTAL_IMAGE=lull-portal:dev
