@page
@model SetupModel
@{
    ViewData["Title"] = "Set up your password";
    var err = Model.Errors.Count > 0 ? "errors" : null;
    var bad = Model.Errors.Count > 0 ? "true" : null;
}
<div class="card login">
    <h1>Set up your password</h1>
    <p class="muted small">Use the one-time setup code your school gave you. You'll sign in with your email and this password from now on.</p>
    <partial name="_Errors" model="Model.Errors" />
    <form method="post">
        <label for="email">Email</label>
        <input type="text" id="email" name="email" value="@Model.Email" autocomplete="username" inputmode="email" autocapitalize="none" autocorrect="off" spellcheck="false" aria-describedby="@(err)" aria-invalid="@(bad)" required>
        <label for="code">Setup code</label>
        <input type="text" id="code" name="code" autocomplete="off" autocapitalize="characters" autocorrect="off" spellcheck="false" placeholder="ABCD-EFGH" aria-describedby="@(err)" aria-invalid="@(bad)" required>
        <label for="password">New password</label>
        <input type="password" id="password" name="password" autocomplete="new-password" aria-describedby="password-rules @(err)" aria-invalid="@(bad)" required>
        <p class="small muted" id="password-rules">@PasswordRules.Describe(Roles.Parent) (School IT accounts: at least @PasswordRules.AdminMinimum characters.)</p>
        <label for="confirm">Confirm password</label>
        <input type="password" id="confirm" name="confirm" autocomplete="new-password" aria-describedby="@(err)" aria-invalid="@(bad)" required>
        <p><button type="submit">Set password and sign in</button></p>
    </form>
    <p class="small"><a href="/Login">Back to sign in</a></p>
</div>
